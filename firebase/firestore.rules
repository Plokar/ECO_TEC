rules_version = '2';

// EcoQuest Firestore rules.
//
// The app awards XP client-side so rewards land instantly and offline. That
// means these rules are the only thing standing between a patched client and an
// invented leaderboard, so they check the *resulting* values rather than trusting
// the caller. FieldValue.increment is resolved before rules run, so
// request.resource.data holds the post-write numbers and can be bounded here.
//
// Known ceiling: a determined cheater can still submit a fake photo and claim a
// plausible reward, because verification happens on their device. Closing that
// needs a Cloud Function re-running detection on the uploaded image, plus App
// Check to block non-app clients. Both are follow-ups, not shipped here.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // --- players ---------------------------------------------------------
    match /users/{uid} {
      // Leaderboards need to read everyone.
      allow read: if signedIn();

      allow create: if signedIn()
                    && request.auth.uid == uid
                    && request.resource.data.xp == 0
                    && request.resource.data.ecoPoints == 0;

      // Your own doc: progress may only move forward, and only so far in one
      // write. A single quest can't plausibly be worth more than this.
      allow update: if signedIn()
                    && request.auth.uid == uid
                    && request.resource.data.xp >= resource.data.xp
                    && request.resource.data.xp <= resource.data.xp + 5000
                    && request.resource.data.ecoPoints >= 0
                    && request.resource.data.ecoPoints
                         <= resource.data.ecoPoints + 2000
                    && request.resource.data.co2SavedG >= resource.data.co2SavedG;

      // Someone else's doc: only to add or remove *yourself* from their friend
      // list, and nothing else in the document may move.
      allow update: if signedIn()
                    && request.auth.uid != uid
                    && changedKeys().hasOnly(['friends'])
                    && request.resource.data.friends.toSet()
                         .difference(resource.data.friends.toSet())
                         .difference([request.auth.uid].toSet()).size() == 0
                    && resource.data.friends.toSet()
                         .difference(request.resource.data.friends.toSet())
                         .difference([request.auth.uid].toSet()).size() == 0;

      // Deleting your own account has to work from inside the app — both
      // stores require it. Only your own.
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // --- live position, friends only --------------------------------------
    //
    // Its own collection because /users is world-readable to signed-in players
    // for the leaderboards, and a coordinate must not be. Each document carries
    // `visibleTo`, a copy of the owner's friend list, and is only handed to a
    // uid inside it. Rules are not filters, so the client's query has to filter
    // on the same field for the read to be allowed at all.
    match /presence/{uid} {
      allow read: if signedIn() && request.auth.uid in resource.data.visibleTo;

      allow create, update: if signedIn()
                    && request.auth.uid == uid
                    && request.resource.data.lat is number
                    && request.resource.data.lng is number
                    && request.resource.data.lat >= -90
                    && request.resource.data.lat <= 90
                    && request.resource.data.lng >= -180
                    && request.resource.data.lng <= 180
                    && request.resource.data.visibleTo is list
                    && request.resource.data.at == request.time
                    // Opting in is a flag on the profile; a position may not
                    // exist without it, whatever a patched client sends.
                    && get(/databases/$(database)/documents/users/$(uid))
                         .data.shareLocation == true;

      // Opting out deletes it. Nobody else can.
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // --- quests (authored in the console or by the seed script) -----------
    match /quests/{questId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // --- proof of completed quests ---------------------------------------
    match /submissions/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;

      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.xpAwarded is int
                    && request.resource.data.xpAwarded >= 0
                    && request.resource.data.xpAwarded <= 5000
                    && request.resource.data.itemsCounted is int
                    && request.resource.data.itemsCounted >= 0
                    && request.resource.data.itemsCounted <= 200
                    // Server clock only — a shifted device clock can't fake recency.
                    && request.resource.data.createdAt == request.time;

      // History is append-only: nobody edits or deletes their own past.
      allow update, delete: if false;
    }

    // --- city / country / school totals ----------------------------------
    match /leagues/{id} {
      allow read: if signedIn();
      // Totals only ever climb. Anyone signed in can contribute, which is the
      // weakest link here — moving this to a Cloud Function is the real fix.
      allow create: if signedIn();
      allow update: if signedIn()
                    && request.resource.data.points >= resource.data.points
                    && request.resource.data.points <= resource.data.points + 2000
                    && request.resource.data.items >= resource.data.items;
      allow delete: if false;
    }

    // --- the eco map ------------------------------------------------------
    match /mapPins/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.lat is number
                    && request.resource.data.lng is number
                    && request.resource.data.lat >= -90
                    && request.resource.data.lat <= 90
                    && request.resource.data.lng >= -180
                    && request.resource.data.lng <= 180;
      // Clearing somebody else's spot retires their pin. A pin only ever goes
      // from open to cleared — nobody can un-clear one, or edit what it says.
      allow update: if signedIn()
                    && changedKeys().hasOnly(['resolved', 'resolvedBy', 'resolvedAt'])
                    && request.resource.data.resolved == true
                    && request.resource.data.resolvedBy == request.auth.uid
                    && request.resource.data.resolvedAt == request.time;
      allow delete: if false;
    }

    // --- partner rewards --------------------------------------------------
    match /rewards/{id} {
      allow read: if signedIn();
      // Catalogue is admin-managed; the client may only draw down stock.
      allow update: if signedIn()
                    && changedKeys().hasOnly(['stock'])
                    && request.resource.data.stock == resource.data.stock - 1
                    && request.resource.data.stock >= 0;
      allow create, delete: if false;
    }

    match /redemptions/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.costPoints is int
                    && request.resource.data.costPoints > 0;
      allow update, delete: if false;
    }

    // Anything not named above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
